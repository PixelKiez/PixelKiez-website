{
  "name": "bds-api",
  "version": "1.0.0",
  "description": "Nimmt das Kontaktformular entgegen und stellt die Anfrage per SMTP ins Postfach zu.",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "mailtest": "node mailtest.mjs",
    "check": "node --check server.mjs && node --check mailtest.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
